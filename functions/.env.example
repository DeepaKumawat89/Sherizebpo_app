# RAZORPAY / RAZORPAYX ENVIRONMENT
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RazorpayX source account number for payouts (Dashboard → Account Details).
# Preferred: store in Firestore platform_settings/main.razorpayAccountNumber.
RAZORPAY_ACCOUNT_NUMBER=your_razorpayx_account_number
# Shared secret set in RazorpayX Dashboard → Settings → Webhooks. Used to verify
# payout.processed / payout.reversed / payout.failed webhook signatures.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# EMAIL VERIFICATION / SMTP
SMTP_PASSWORD=your_gmail_app_password
SMTP_EMAIL=your_email@example.com

# TWILIO CONFIGURATION
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# CALL PROVIDER SWITCH — which telephony provider /start-call uses.
# "exotel" (default) or "twilio". Set to "twilio" to route app calls through
# Twilio for temporary testing without removing Exotel. Revert by removing this
# line (or setting it back to "exotel"). A per-request `provider` field on
# /start-call overrides this default.
CALL_PROVIDER=exotel

# EXOTEL VOIP CONFIGURATION
# Find these in Exotel Dashboard → Settings → API Credentials & ExoPhones.
# NEVER commit real values — keep them only in your local .env / Functions config.
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
# Optional comma-separated pool. Calls are distributed deterministically across
# these ExoPhones. Account channel capacity still controls simultaneous calls.
# EXOTEL_PHONE_NUMBER remains the single-number fallback.
EXOTEL_PHONE_NUMBERS=your_first_exophone,your_second_exophone
EXOTEL_PHONE_NUMBER=your_exophone_number
# Mumbai-region accounts use api.in.exotel.com (default). Global accounts use api.exotel.com.
EXOTEL_SUBDOMAIN=api.in.exotel.com

# VOIP WEBHOOK AUTH — shared secret appended to Exotel/Twilio StatusCallback
# URLs and verified on inbound webhooks. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your_random_webhook_secret

# Public base URL of the Express API (used to register the Exotel StatusCallback
# so call status + recording URLs are delivered back). Typically the /api function:
WEBHOOK_BASE_URL=https://<region>-<project>.cloudfunctions.net/api
