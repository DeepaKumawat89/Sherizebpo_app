# Root project environment template.
# Keep real values in local, untracked environment files or managed secret storage.
# Firebase client configuration is generated in the platform config files and is
# intentionally public; never place Firebase Admin credentials or private keys here.

# Server/provider secrets are consumed by Firebase Functions.
# See functions/.env.example for the complete Functions template.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_email_app_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
WEBHOOK_SECRET=your_random_webhook_secret
